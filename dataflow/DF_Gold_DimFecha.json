{
	"name": "DF_Gold_DimFecha",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Silver_Admissions",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Gold_DimFecha",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "DatosNumericosFecha"
				},
				{
					"name": "DatosTextoFecha"
				}
			],
			"scriptLines": [
				"source(output(",
				"          fecha_completa as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: (\"SELECT DATEADD(DAY, CAST(n AS INT), CAST('2023-01-01' AS DATE)) AS fecha_completa FROM (SELECT ROW_NUMBER() OVER (ORDER BY admission_id) - 1 AS n FROM silver.admissions) AS numeros WHERE n < 1461\"),",
				"     format: 'query') ~> source1",
				"source1 derive(fecha_key = toInteger(toString(fecha_completa,'yyyyMMdd')),",
				"          anio = year(fecha_completa),",
				"          trimestre = toInteger(ceil(month(fecha_completa)/3.0)),",
				"          mes = month(fecha_completa),",
				"          semana_anio = weekOfYear(fecha_completa),",
				"          dia_mes = dayOfMonth(fecha_completa),",
				"          dia_semana = iif(dayOfWeek(fecha_completa)==1,7,dayOfWeek(fecha_completa)-1),",
				"          es_fin_semana = dayOfWeek(fecha_completa) == 1 || dayOfWeek(fecha_completa) == 7\r",
				") ~> DatosNumericosFecha",
				"DatosNumericosFecha derive(trimestre_nombre = concat('T',toString(trimestre)),",
				"          mes_nombre = initCap(toString(fecha_completa,'MMMM','es-ES')),",
				"          mes_corto = initCap(substring(toString(fecha_completa,'MMMM','es-ES'),1,3)),",
				"          dia_nombre = initCap(toString(fecha_completa,'EEEE','es-ES'))) ~> DatosTextoFecha",
				"DatosTextoFecha sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          fecha_key as integer,",
				"          fecha_completa as date,",
				"          anio as integer,",
				"          trimestre as integer,",
				"          trimestre_nombre as string,",
				"          mes as integer,",
				"          mes_nombre as string,",
				"          mes_corto as string,",
				"          semana_anio as integer,",
				"          dia_mes as integer,",
				"          dia_semana as integer,",
				"          dia_nombre as string,",
				"          es_fin_de_semana as boolean",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          fecha_key,",
				"          fecha_completa,",
				"          anio,",
				"          trimestre,",
				"          trimestre_nombre,",
				"          mes,",
				"          mes_nombre,",
				"          mes_corto,",
				"          semana_anio,",
				"          dia_mes,",
				"          dia_semana,",
				"          dia_nombre,",
				"          es_fin_de_semana = es_fin_semana",
				"     )) ~> sink1"
			]
		}
	}
}